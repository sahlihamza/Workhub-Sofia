# Application
PORT=3000
FRONTEND_URL=http://localhost:4200

# JWT
# Utiliser des valeurs longues, aleatoires et differentes en local/production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Password hashing
PASSWORD_SECRET=replace-with-a-long-random-password-secret

# SMTP / Brevo
# Necessaire pour l'envoi des e-mails (reset password, notifications, etc.).
SENDINBLUE_EMAIL=your-email@example.com
SENDINBLUE_API_KEY=your-brevo-api-key

# Superadmin seed
# Necessaire uniquement pour npm run seed:superadmin.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password

# Calendarific
# Necessaire uniquement pour les fonctionnalites de jours feries.
CALENDARIFIC_API_KEY=your-calendarific-api-key
